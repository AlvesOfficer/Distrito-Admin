local function Notify(titulo, mensagem, duracao, estilo)
	duracao = duracao or 4
	estilo = estilo or "i"
	local cores = {i = CFG.C.Blu, s = CFG.C.Grn, w = CFG.C.Ong, e = CFG.C.Red}
	local cor = cores[estilo] or CFG.C.Red
	local frame = Create("CanvasGroup", {
		Size = UDim2.new(0, 0, 0, 0),
		Position = UDim2.new(1, -10, 0.72, 0),
		AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = CFG.C.S1,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 999,
		Parent = SAFE,
	})
	Corner(frame, 8)
	Stroke(frame, cor, 0.3)
	Gradient(frame, "bg")
	Create("Frame", {
		Size = UDim2.new(0, 3, 1, 0),
		BackgroundColor3 = cor,
		BorderSizePixel = 0,
		ZIndex = 1000,
		Parent = frame,
	})
	Create("TextLabel", {
		Size = UDim2.new(1, -14, 0, 20),
		Position = UDim2.new(0, 10, 0, 7),
		Text = titulo:upper(),
		TextColor3 = CFG.C.T1,
		Font = CFG.F.B,
		TextSize = MOBILE and 13 or 11,
		BackgroundTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 1000,
		Parent = frame,
	})
	Create("TextLabel", {
		Size = UDim2.new(1, -14, 0, 16),
		Position = UDim2.new(0, 10, 0, 28),
		Text = mensagem,
		TextColor3 = CFG.C.T2,
		Font = CFG.F.S,
		TextSize = MOBILE and 11 or 10,
		BackgroundTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		ZIndex = 1000,
		Parent = frame,
	})
	Tween(frame, {Size = UDim2.new(0, 280, 0, 56)}, 0.3)
	task.delay(duracao, function()
		if not frame.Parent then return end
		Tween(frame, {Size = UDim2.new(0, 280, 0, 0), BackgroundTransparency = 1}, 0.2)
		task.delay(0.2, function() frame:Destroy() end)
	end)
end

