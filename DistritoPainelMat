-- ===== ESP (normal e inteligente) =====

local function estaNaVisaoDireta(posicaoAlvo, personagemAlvo)
	local camera = workspace.CurrentCamera
	local origem = camera.CFrame.Position
	local direcao = posicaoAlvo - origem

	raycastParams.FilterDescendantsInstances = { jogadorLocal.Character, personagemAlvo }

	local resultado = workspace:Raycast(origem, direcao, raycastParams)
	return resultado == nil
end

local function iniciarEsp()
	reconstruirFilaVisibilidade()

	for _, jogador in ipairs(Players:GetPlayers()) do
		if jogador ~= jogadorLocal then
			criarEspNoJogador(jogador)
			espConexoes["personagem_" .. jogador.UserId] = jogador.CharacterAdded:Connect(function()
				task.wait(0.5)
				criarEspNoJogador(jogador)
				reconstruirFilaVisibilidade()
			end)
		end
	end

	reconstruirFilaVisibilidade()

	espConexoes.jogadorEntrou = Players.PlayerAdded:Connect(function(jogador)
		espConexoes["personagem_" .. jogador.UserId] = jogador.CharacterAdded:Connect(function()
			task.wait(0.5)
			criarEspNoJogador(jogador)
			reconstruirFilaVisibilidade()
		end)
	end)

	espConexoes.jogadorSaiu = Players.PlayerRemoving:Connect(function(jogador)
		removerEspDoJogador(jogador)
		reconstruirFilaVisibilidade()
	end)

	local acumuladorLeve = 0
	local acumuladorReconciliacao = 0

	espAtualizacaoConexao = RunService.Heartbeat:Connect(function(delta)
		local raizLocal = jogadorLocal.Character and jogadorLocal.Character:FindFirstChild("HumanoidRootPart")
		if not raizLocal then
			return
		end

		acumuladorReconciliacao += delta
		if acumuladorReconciliacao >= INTERVALO_RECONCILIACAO then
			acumuladorReconciliacao = 0
			sincronizarEsp()
			reconstruirFilaVisibilidade()
		end

		acumuladorLeve += delta
		if acumuladorLeve >= INTERVALO_ATUALIZACAO_LEVE then
			acumuladorLeve = 0
			for jogador, objetos in pairs(espObjetos) do
				local raizAlvo = jogador.Character and jogador.Character:FindFirstChild("HumanoidRootPart")
				if raizAlvo and objetos.distanciaLabel then
					local distancia = (raizAlvo.Position - raizLocal.Position).Magnitude
					objetos.distanciaLabel.Text = math.floor(distancia) .. "m"
				end
			end
		end

		if estado.modoEsp == "inteligente" and #filaVisibilidade > 0 then
			for _ = 1, math.min(JOGADORES_POR_FRAME, #filaVisibilidade) do
				if indiceFilaVisibilidade > #filaVisibilidade then
					indiceFilaVisibilidade = 1
				end

				local jogador = filaVisibilidade[indiceFilaVisibilidade]
				local objetos = espObjetos[jogador]
				if objetos and objetos.partesHighlight then
					for parte, highlight in pairs(objetos.partesHighlight) do
						local visivel = estaNaVisaoDireta(parte.Position, objetos.personagem)
						local cor = visivel and CORES.espVisivel or CORES.espOculto
						highlight.FillColor = cor
						highlight.OutlineColor = cor
					end
				end

				indiceFilaVisibilidade += 1
			end
		end
	end)
end

local function pararEsp()
	for jogador in pairs(espObjetos) do
		removerEspDoJogador(jogador)
	end

	for _, conexao in pairs(espConexoes) do
		conexao:Disconnect()
	end
	espConexoes = {}

	filaVisibilidade = {}
	indiceFilaVisibilidade = 1

	if espAtualizacaoConexao then
		espAtualizacaoConexao:Disconnect()
		espAtualizacaoConexao = nil
	end
end

local function atualizarBotoesEsp()
	local normalAtivo = estado.modoEsp == "normal"
	local inteligenteAtivo = estado.modoEsp == "inteligente"

	TweenService:Create(botaoEspNormal, TWEEN_RAPIDO, { BackgroundColor3 = normalAtivo and CORES.ativo or CORES.inativo }):Play()
	statusEspNormal.Text = normalAtivo and "ON" or "OFF"
	statusEspNormal.TextColor3 = normalAtivo and CORES.textoPrincipal or CORES.textoSecundario
	dotEspNormal.BackgroundColor3 = normalAtivo and CORES.espVisivel or CORES.textoSecundario

	TweenService:Create(botaoEspInteligente, TWEEN_RAPIDO, { BackgroundColor3 = inteligenteAtivo and CORES.ativo or CORES.inativo }):Play()
	statusEspInteligente.Text = inteligenteAtivo and "ON" or "OFF"
	statusEspInteligente.TextColor3 = inteligenteAtivo and CORES.textoPrincipal or CORES.textoSecundario
	dotEspInteligente.BackgroundColor3 = inteligenteAtivo and CORES.espVisivel or CORES.textoSecundario
end

local function definirModoEsp(novoModo)
	if estado.modoEsp ~= "off" then
		pararEsp()
	end

	if estado.modoEsp == novoModo then
		estado.modoEsp = "off"
	else
		estado.modoEsp = novoModo
		iniciarEsp()
	end

	atualizarBotoesEsp()
end

botaoEspNormal.MouseButton1Click:Connect(function()
	definirModoEsp("normal")
end)

botaoEspInteligente.MouseButton1Click:Connect(function()
	definirModoEsp("inteligente")
end)

