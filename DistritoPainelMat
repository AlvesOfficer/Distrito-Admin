local function conectarArraste(alvoDeteccao, alvoMovido)
	local arrastando = false
	local offset = Vector2.new()

	alvoDeteccao.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			arrastando = true
			offset = Vector2.new(input.Position.X, input.Position.Y) - Vector2.new(alvoMovido.AbsolutePosition.X, alvoMovido.AbsolutePosition.Y)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if arrastando and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local viewport = workspace.CurrentCamera.ViewportSize
			local tamanho = alvoMovido.AbsoluteSize
			local novaPos = Vector2.new(input.Position.X, input.Position.Y) - offset
			local x = math.clamp(novaPos.X, 0, math.max(viewport.X - tamanho.X, 0))
			local y = math.clamp(novaPos.Y, 0, math.max(viewport.Y - tamanho.Y, 0))
			alvoMovido.Position = UDim2.fromOffset(x, y)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			arrastando = false
		end
	end)
end

