-- ===================================================================
local ChatSystem = {}
ChatSystem.OnLog = nil
ChatSystem.OnStaff = nil

function ChatSystem:AddLog(categoria, jogador, mensagem)
	local entry = {
		Tempo = os.date("%H:%M:%S"),
		Categoria = categoria,
		Jogador = jogador,
		Mensagem = mensagem,
	}
	table.insert(D.ChatLogs, entry)
	while #D.ChatLogs > 500 do table.remove(D.ChatLogs, 1) end
	if ChatSystem.OnLog then ChatSystem.OnLog(entry) end
end

function ChatSystem:GetLogs(filtro, limite)
	limite = limite or 100
	local resultado = {}
	local count = 0
	for i = #D.ChatLogs, 1, -1 do
		local log = D.ChatLogs[i]
		local match = not filtro or filtro == ""
		if not match then
			match = log.Jogador:lower():find(filtro:lower()) or log.Mensagem:lower():find(filtro:lower())
		end
		if match then
			table.insert(resultado, 1, log)
			count = count + 1
		end
		if count >= limite then break end
	end
	return resultado
end

function ChatSystem:ClearLogs()
	D.ChatLogs = {}
	if ChatSystem.OnLog then ChatSystem.OnLog(nil) end
end

function ChatSystem:AddStaffMsg(jogador, mensagem, userId)
	local entry = {
		Tempo = os.date("%H:%M:%S"),
		Jogador = jogador,
		UserId = userId or (Players:FindFirstChild(jogador) and Players[jogador].UserId) or 0,
		Mensagem = mensagem,
	}
	table.insert(D.StaffChat, entry)
	while #D.StaffChat > 300 do table.remove(D.StaffChat, 1) end
	if ChatSystem.OnStaff then ChatSystem.OnStaff(entry) end
end

function ChatSystem:GetStaffMsgs(limite)
	limite = limite or 50
	local resultado = {}
	local inicio = math.max(1, #D.StaffChat - limite + 1)
	for i = inicio, #D.StaffChat do
		table.insert(resultado, D.StaffChat[i])
	end
	return resultado
end

