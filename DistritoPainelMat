conectarArraste(barraTitulo, painel)

local function liberarMouse()
	comportamentoMouseAnterior = UserInputService.MouseBehavior
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	UserInputService.MouseIconEnabled = true
end

local function restaurarMouse()
	if comportamentoMouseAnterior ~= nil then
		UserInputService.MouseBehavior = comportamentoMouseAnterior
		comportamentoMouseAnterior = nil
	end
end

local function abrirFecharPainel()
	estado.painelAberto = not estado.painelAberto

	if estado.painelAberto then
		painel.Visible = true
		painelEscala.Scale = 0.9
		TweenService:Create(painelEscala, TWEEN_ABRIR, { Scale = 1 }):Play()
		liberarMouse()
	else
		painel.Visible = false
		restaurarMouse()
	end
end

local function fecharPainel()
	estado.painelAberto = false
	painel.Visible = false
	restaurarMouse()
end

botaoFlutuante.MouseButton1Click:Connect(abrirFecharPainel)
botaoFechar.MouseButton1Click:Connect(fecharPainel)

UserInputService.InputBegan:Connect(function(input, processadoPelaUI)
	if processadoPelaUI then
		return
	end
	if input.KeyCode == TECLA_ABRIR_PAINEL then
		abrirFecharPainel()
	end
end)

-- ===== TIMES AMIGOS =====

local function jogadorEhAmigo(jogador)
	return jogador.Team ~= nil and equipesAmigas[jogador.Team] == true
end

local function removerEspDoJogador(jogador)
	local objetos = espObjetos[jogador]
	if not objetos then
		return
	end

	if objetos.highlight then
		objetos.highlight:Destroy()
	end
	if objetos.partesHighlight then
		for _, highlight in pairs(objetos.partesHighlight) do
			highlight:Destroy()
		end
	end
	if objetos.billboard then
		objetos.billboard:Destroy()
	end

	espObjetos[jogador] = nil
end

local function obterPartesDoCorpo(personagem)
	local partes = {}
	for _, filho in ipairs(personagem:GetChildren()) do
		if filho:IsA("BasePart") and filho.Name ~= "HumanoidRootPart" and filho.Transparency < 1 then
			table.insert(partes, filho)
		end
	end
	return partes
end

local function obterNomeExibicao(jogador)
	if estado.modoNome == "apelido" then
		return jogador.DisplayName
	end
	return jogador.Name
end

local function criarEspNoJogador(jogador)
	if jogador == jogadorLocal or jogadorEhAmigo(jogador) then
		return
	end

	local personagem = jogador.Character
	if not personagem then
		return
	end

	local raizPersonagem = personagem:FindFirstChild("HumanoidRootPart")
	local humanoid = personagem:FindFirstChildOfClass("Humanoid")
	if not raizPersonagem or not humanoid then
		return
	end

	local raizLocal = jogadorLocal.Character and jogadorLocal.Character:FindFirstChild("HumanoidRootPart")
	if raizLocal and (raizPersonagem.Position - raizLocal.Position).Magnitude > estado.distanciaMaximaEsp then
		return
	end

	removerEspDoJogador(jogador)

	local dados = {
		personagem = personagem,
		billboard = nil,
		distanciaLabel = nil,
		nomeLabel = nil,
		highlight = nil,
		partesHighlight = nil,
	}

	if estado.modoEsp == "inteligente" then
		dados.partesHighlight = {}
		for _, parte in ipairs(obterPartesDoCorpo(personagem)) do
			local highlight = Instance.new("Highlight")
			highlight.Name = "ESP_Highlight"
			highlight.FillColor = CORES.espOculto
			highlight.FillTransparency = 0.7
			highlight.OutlineColor = CORES.espOculto
			highlight.OutlineTransparency = 0
			highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			highlight.Adornee = parte
			highlight.Parent = personagem
			dados.partesHighlight[parte] = highlight
		end
	else
		local highlight = Instance.new("Highlight")
		highlight.Name = "ESP_Highlight"
		highlight.FillColor = CORES.espNormal
		highlight.FillTransparency = 0.7
		highlight.OutlineColor = CORES.espNormal
		highlight.OutlineTransparency = 0
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Adornee = personagem
		highlight.Parent = personagem
		dados.highlight = highlight
	end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "ESP_Billboard"
	billboard.Size = UDim2.fromOffset(160, 36)
