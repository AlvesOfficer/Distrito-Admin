-- ============================================
-- FUNÇÃO DE ENVIO DE SPAM
-- ============================================
local function sendMessage()
	local currentTime = tick()

	if currentTime - lastMessageTime < Config.MessageDelay then
		local waitTime = Config.MessageDelay - (currentTime - lastMessageTime)
		if isOpen then
			status.Text = "Aguarde " .. string.format("%.2f", waitTime) .. "s"
			status.TextColor3 = Color3.fromRGB(255, 150, 0)
		end
		return
	end

	local message = textBox.Text
	if message == "" or message:gsub("%s+", "") == "" then
		if isOpen then
			status.Text = "Digite alguma coisa!"
			status.TextColor3 = Color3.fromRGB(255, 95, 87)
			task.wait(2)
			status.Text = "Pronto para enviar"
			status.TextColor3 = Color3.fromRGB(180, 180, 180)
		end
		return
	end

	lastMessageTime = currentTime

	if isOpen then
		status.Text = "Enviado!"
		status.TextColor3 = Color3.fromRGB(92, 184, 92)
	end

	-- Efeito visual no botão mobile
	if quickModeMobileEnabled and quickMobileBtn then
		coroutine.wrap(function()
			TweenService:Create(quickMobileGlow, TweenInfo.new(0.1), {
				BackgroundTransparency = 0.2
			}):Play()
			TweenService:Create(quickMobileBtn, TweenInfo.new(0.1), {
				BackgroundColor3 = Color3.fromRGB(0, 220, 255)
			}):Play()
			task.wait(0.15)
			TweenService:Create(quickMobileGlow, TweenInfo.new(0.3), {
				BackgroundTransparency = 0.6
			}):Play()
			TweenService:Create(quickMobileBtn, TweenInfo.new(0.3), {
				BackgroundColor3 = Color3.fromRGB(0, 150, 255)
			}):Play()
		end)()
	end

	pcall(function()
		if ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents") then
			local folder = ReplicatedStorage.DefaultChatSystemChatEvents
			if folder:FindFirstChild("SayMessageRequest") then
				folder.SayMessageRequest:FireServer(message, "All")
				return
			end
		end

		local TextChatService = game:GetService("TextChatService")
		if TextChatService then
			local textChannels = TextChatService:FindFirstChild("TextChannels")
			if textChannels then
				local general = textChannels:FindFirstChild("RBXGeneral")
				if general then
					general:SendAsync(message)
					return
				end
			end
		end
	end)

	if isOpen then
		task.wait(1.5)
		status.Text = "Pronto para enviar"
		status.TextColor3 = Color3.fromRGB(180, 180, 180)
	end
end

