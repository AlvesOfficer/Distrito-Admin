local function sincronizarEsp()
	if estado.modoEsp == "off" then
		return
	end

	local raizLocal = jogadorLocal.Character and jogadorLocal.Character:FindFirstChild("HumanoidRootPart")

	for _, jogador in ipairs(Players:GetPlayers()) do
		if jogador ~= jogadorLocal then
			local personagem = jogador.Character
			local raizAlvo = personagem and personagem:FindFirstChild("HumanoidRootPart")
			local temEsp = espObjetos[jogador] ~= nil
			local deveTerEsp = false

			if raizAlvo and raizLocal and not jogadorEhAmigo(jogador) then
				local distancia = (raizAlvo.Position - raizLocal.Position).Magnitude
				deveTerEsp = distancia <= estado.distanciaMaximaEsp
			end

			if deveTerEsp and not temEsp then
				criarEspNoJogador(jogador)
			elseif not deveTerEsp and temEsp then
				removerEspDoJogador(jogador)
			end
		end
	end
end

local function reconstruirFilaVisibilidade()
	filaVisibilidade = {}
	for jogador in pairs(espObjetos) do
		table.insert(filaVisibilidade, jogador)
	end
	indiceFilaVisibilidade = 1
end

