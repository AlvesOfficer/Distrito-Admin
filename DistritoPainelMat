-- ===================================================================
-- CHAT DA STAFF — MENSAGENS AUTOMÁTICAS (feature 4)
-- ===================================================================
-- Em vez de texto livre (que o filtro de chat do Roblox pode bloquear quando
-- um dos admins é menor de idade / conta não verificada), os admins disparam
-- frases prontas em CFG.PresetMsgs. Elas são retransmitidas pelo servidor
-- para TODOS os admins conectados — isso é chat de verdade entre clientes
-- diferentes, e não só uma lista local visível pra quem enviou.
function CMD:EnviarAlerta(mensagem, alvoNome)
	if not mensagem or mensagem == "" then return end
	alvoNome = alvoNome or ""
	if RemoteAlerta then
		RemoteAlerta:FireServer(mensagem, alvoNome)
	else
		-- Sem o script de servidor instalado (ver DistritoAdmin_Servidor.lua),
		-- a mensagem só pode aparecer localmente.
		local texto = alvoNome ~= "" and (mensagem .. "  →  " .. alvoNome) or mensagem
		ChatSystem:AddStaffMsg(LP.Name, texto, LP.UserId)
		Notify("CHAT DA STAFF", "Servidor não conectado: mensagem ficou só com você.", 4, "w")
	end
end

if RemoteAlerta then
	RemoteAlerta.OnClientEvent:Connect(function(nomeRemetente, mensagem, alvoNome, userId)
		local texto = mensagem
		if alvoNome and alvoNome ~= "" then
			texto = texto .. "  →  " .. alvoNome
		end
		ChatSystem:AddStaffMsg(nomeRemetente, texto, userId)
		if nomeRemetente ~= LP.Name then
			Notify("STAFF: " .. nomeRemetente, texto, 4, "w")
		end
	end)
end

-- ===================================================================
-- PERFIS DE JOGADORES — DATA DE CRIAÇÃO CONFIRMADA (feature 5)
-- ===================================================================
-- Consulta o servidor (que chama a API pública do Roblox) e guarda em cache
-- por UserId. Se o servidor não estiver instalado ou a consulta falhar, cai
-- para uma data ESTIMADA a partir de Player.AccountAge (dias desde a criação).
local PerfilCache = {}
function CMD:ObterInfoConta(alvo)
	local uid = alvo.UserId
	if PerfilCache[uid] then return PerfilCache[uid] end
	local resultado = nil
	if RemoteConta then
		local ok, dados = pcall(function() return RemoteConta:InvokeServer(uid) end)
		if ok and typeof(dados) == "table" and dados.Ok and dados.Criado then
			resultado = {Texto = dados.Criado, Confirmado = true}
		end
	end
	if not resultado then
		local dias = alvo.AccountAge or 0
		local ok, dataEstim = pcall(function() return os.date("!*t", os.time() - dias * 86400) end)
		if ok and dataEstim then
			resultado = {
				Texto = string.format("%02d/%02d/%04d (estimado)", dataEstim.day, dataEstim.month, dataEstim.year),
				Confirmado = false,
			}
		else
			resultado = {Texto = "Desconhecida", Confirmado = false}
		end
	end
	PerfilCache[uid] = resultado
	return resultado
end

