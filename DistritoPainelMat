-- ============================================
-- FUNÇÃO PARA RECRIAR BOTÃO COM NOVO TAMANHO
-- ============================================
local function rebuildQuickMobileButton()
	if quickMobileBtn then
		local wasVisible = quickMobileBtn.Visible
		local position = quickMobileBtn.Position
		quickMobileBtn:Destroy()
		quickMobileBtn, quickMobileGlow = createQuickMobileButton()
		quickMobileBtn.Visible = wasVisible
		quickMobileBtn.Position = position

		-- Reconectar eventos
		quickMobileBtn.MouseButton1Click:Connect(sendMessage)
		quickMobileBtn.MouseEnter:Connect(function()
			local baseSize = 30 + (Config.QuickModeButtonSize * 3)
			TweenService:Create(quickMobileBtn, TweenInfo.new(0.2), {
				Size = UDim2.new(0, baseSize + 5, 0, baseSize + 5)
			}):Play()
			TweenService:Create(quickMobileGlow, TweenInfo.new(0.2), {
				BackgroundTransparency = 0.3
			}):Play()
		end)
		quickMobileBtn.MouseLeave:Connect(function()
			local baseSize = 30 + (Config.QuickModeButtonSize * 3)
			TweenService:Create(quickMobileBtn, TweenInfo.new(0.2), {
				Size = UDim2.new(0, baseSize, 0, baseSize)
			}):Play()
			TweenService:Create(quickMobileGlow, TweenInfo.new(0.2), {
				BackgroundTransparency = 0.6
			}):Play()
		end)
	end
end

