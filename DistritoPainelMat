local CMD = {Active = {}, Connections = {}, ESP = {}}

function CMD:Voar(velocidade)
	velocidade = math.clamp(velocidade or 50, 1, 400)
	CMD.Active.Voo = true
	CMD.Active.VelocidadeVoo = velocidade
	if CMD.Connections.Voo then CMD.Connections.Voo:Disconnect() end
	CMD.Connections.Voo = RunService.RenderStepped:Connect(function()
		if not CMD.Active.Voo then return end
		pcall(function()
			local char = LP.Character
			if not char then return end
			local hrp = char:FindFirstChild("HumanoidRootPart")
			local hum = char:FindFirstChild("Humanoid")
			if not hrp or not hum then return end
			local bg = hrp:FindFirstChild("DA_BG")
			local bv = hrp:FindFirstChild("DA_BV")
			if not bg then bg = Create("BodyGyro", {Name = "DA_BG", MaxTorque = Vector3.new(9e9, 9e9, 9e9), Parent = hrp}) end
			if not bv then bv = Create("BodyVelocity", {Name = "DA_BV", MaxForce = Vector3.new(9e9, 9e9, 9e9), Parent = hrp}) end
			bg.CFrame = Camera.CFrame
			local dir = Vector3.zero
			if UIS:IsKeyDown(Enum.KeyCode.W) then dir += Camera.CFrame.LookVector end
			if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= Camera.CFrame.LookVector end
			if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= Camera.CFrame.RightVector end
			if UIS:IsKeyDown(Enum.KeyCode.D) then dir += Camera.CFrame.RightVector end
			if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0, 1, 0) end
			if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then dir -= Vector3.new(0, 1, 0) end
			bv.Velocity = dir * CMD.Active.VelocidadeVoo
			hum.PlatformStand = true
		end)
	end)
	Notify("VOO", "Ativado | " .. velocidade, 2, "s")
end

function CMD:PararVoo()
	CMD.Active.Voo = false
	if CMD.Connections.Voo then CMD.Connections.Voo:Disconnect(); CMD.Connections.Voo = nil end
	pcall(function()
		local char = LP.Character
		if char then
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if hrp then
				local bg = hrp:FindFirstChild("DA_BG"); if bg then bg:Destroy() end
				local bv = hrp:FindFirstChild("DA_BV"); if bv then bv:Destroy() end
			end
			local hum = char:FindFirstChild("Humanoid")
			if hum then hum.PlatformStand = false end
		end
	end)
	Notify("VOO", "Desativado", 2)
end

function CMD:Velocidade(valor)
	valor = math.clamp(valor or 16, 1, 400)
	CMD.Active.Velocidade = valor
	pcall(function()
		local char = LP.Character
		if char then local hum = char:FindFirstChild("Humanoid"); if hum then hum.WalkSpeed = valor end end
	end)
	Notify("VELOCIDADE", "Definida: " .. valor, 2, "s")
end

function CMD:ResetarVelocidade()
	CMD.Active.Velocidade = nil
	pcall(function()
		local char = LP.Character
		if char then local hum = char:FindFirstChild("Humanoid"); if hum then hum.WalkSpeed = 16 end end
	end)
	Notify("VELOCIDADE", "Resetada (16)", 2)
end

function CMD:AtravessarParedes()
	CMD.Active.NoClip = not CMD.Active.NoClip
	pcall(function()
		local char = LP.Character
		if char then
			for _, part in pairs(char:GetDescendants()) do
				if part:IsA("BasePart") then part.CanCollide = not CMD.Active.NoClip end
			end
		end
	end)
	Notify("ATRAVESSAR", CMD.Active.NoClip and "Ativado" or "Desativado", 2)
end

function CMD:Invisibilidade()
	CMD.Active.Invisivel = not CMD.Active.Invisivel
	pcall(function()
		local char = LP.Character
		if char then
			local tr = CMD.Active.Invisivel and 0.85 or 0
			for _, part in pairs(char:GetChildren()) do
				if part:IsA("BasePart") then part.Transparency = tr end
			end
		end
	end)
	Notify("INVISIBILIDADE", CMD.Active.Invisivel and "Ativada" or "Desativada", 2)
end

function CMD:Teleporte(nome)
	local alvo = Players:FindFirstChild(nome)
	if not alvo or not alvo.Character then Notify("ERRO", "Jogador não encontrado", 2, "e") return end
	local hrp = alvo.Character:FindFirstChild("HumanoidRootPart")
	if hrp and LP.Character then
		LP.Character:MoveTo(hrp.Position + Vector3.new(0, 3, 0))
		Notify("TELEPORTE", "Para: " .. nome, 2, "s")
	end
end

function CMD:ESP_Adicionar(nome)
	local alvo = Players:FindFirstChild(nome)
	if not alvo or CMD.ESP[alvo.Name] then return end
	pcall(function()
		local char = alvo.Character
		if not char then return end
		local cabeca = char:FindFirstChild("Head")
		if not cabeca then return end
		local hl = Create("Highlight", {
			Name = "DA_ESP",
			FillColor = CFG.C.Red,
			OutlineColor = CFG.C.Acc,
			FillTransparency = 0.5,
			Adornee = char,
			Parent = char,
		})
		local bb = nil
		if D.ESP_Name then
			bb = Create("BillboardGui", {
				Name = "DA_ESP_BB",
				Size = UDim2.new(0, 200, 0, 40),
				Adornee = cabeca,
				StudsOffset = Vector3.new(0, 3.5, 0),
				AlwaysOnTop = true,
				Parent = cabeca,
			})
			local bg = Create("Frame", {
				Size = UDim2.new(1, 0, 1, 0),
				BackgroundColor3 = Color3.fromRGB(0, 0, 0),
				BackgroundTransparency = 0.45,
				BorderSizePixel = 0,
				Parent = bb,
			})
			Corner(bg, 4)
			Create("TextLabel", {
				Size = UDim2.new(1, 0, 0, 20),
				Text = alvo.Name,
				TextColor3 = CFG.C.T1,
				Font = CFG.F.B,
				TextSize = 13,
				BackgroundTransparency = 1,
				Parent = bg,
			})
			Create("TextLabel", {
				Name = "ESP_Info",
				Size = UDim2.new(1, 0, 0, 18),
				Position = UDim2.new(0, 0, 0, 20),
				Text = "",
				TextColor3 = CFG.C.Acc,
				Font = CFG.F.S,
				TextSize = 11,
				BackgroundTransparency = 1,
				Parent = bg,
			})
		end
		CMD.ESP[alvo.Name] = {HL = hl, BB = bb, Player = alvo}
		if CMD.ESP[alvo.Name].RC then CMD.ESP[alvo.Name].RC:Disconnect() end
		CMD.ESP[alvo.Name].RC = alvo.CharacterAdded:Connect(function()
			local old = CMD.ESP[alvo.Name]
			if old then
				pcall(function() old.HL:Destroy() end)
				pcall(function() if old.BB then old.BB:Destroy() end end)
			end
			CMD.ESP[alvo.Name] = nil
			task.wait(0.4)
			CMD:ESP_Adicionar(nome)
		end)
	end)
	Notify("ESP", "Ativado: " .. nome, 2, "s")
end

function CMD:ESP_Todos()
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= LP then CMD:ESP_Adicionar(p.Name) end
	end
	Notify("ESP", "Ativado para todos", 2, "s")
end

function CMD:ESP_Remover(nome)
	local entry = CMD.ESP[nome]
	if entry then
		pcall(function() entry.RC:Disconnect() end)
		pcall(function() entry.HL:Destroy() end)
		pcall(function() if entry.BB then entry.BB:Destroy() end end)
		CMD.ESP[nome] = nil
	end
end

function CMD:ESP_RemoverTodos()
	for nome in pairs(CMD.ESP) do CMD:ESP_Remover(nome) end
	Notify("ESP", "Removido de todos", 2)
end

function CMD:ESP_AlternarNomes()
	D.ESP_Name = not D.ESP_Name
	local salvo = {}
	for n in pairs(CMD.ESP) do salvo[n] = true end
	CMD:ESP_RemoverTodos()
	for n in pairs(salvo) do CMD:ESP_Adicionar(n) end
	Notify("ESP", D.ESP_Name and "Nomes visíveis" or "Nomes ocultos", 2)
end

