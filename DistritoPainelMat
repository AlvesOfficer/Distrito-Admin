-- ===================================================================
-- REMOTOS (comunicação real entre clientes, via servidor)
-- ===================================================================
-- Um LocalScript nunca consegue falar direto com o LocalScript de outro
-- jogador — tudo tem que passar pelo servidor. Por isso o Chat da Staff e a
-- busca de "data de criação confirmada" dependem do script de servidor que
-- acompanha este arquivo (DistritoAdmin_Servidor.lua, em ServerScriptService).
-- Se ele não estiver instalado, o painel avisa e cai para um modo local/estimado.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local REMOTOS_PASTA = "DA10_Remotes"

local function ObterRemoto(nome)
	local ok, resultado = pcall(function()
		local pasta = ReplicatedStorage:WaitForChild(REMOTOS_PASTA, 6)
		if not pasta then return nil end
		return pasta:WaitForChild(nome, 6)
	end)
	if ok then return resultado end
	return nil
end

local RemoteAlerta = ObterRemoto("StaffAlert")
local RemoteConta = ObterRemoto("GetAccountInfo")
local SERVIDOR_OK = (RemoteAlerta ~= nil) and (RemoteConta ~= nil)

