			sideVisivel = not sideVisivel
			if sideVisivel then
				Sidebar.Visible = true
				Tween(Sidebar, {Size = UDim2.new(0, 200, 1, 0)}, 0.2)
			else
				Tween(Sidebar, {Size = UDim2.new(0, 0, 1, 0)}, 0.2)
				task.delay(0.2, function() if not sideVisivel then Sidebar.Visible = false end end)
			end
		end)
		Sidebar.ZIndex = 10
	end

	ContentArea = Create("Frame", {
		Name = "Content",
		Size = UDim2.new(1, MOBILE and 0 or -200, 1, -48),
		Position = UDim2.new(0, MOBILE and 0 or 200, 0, 48),
		BackgroundColor3 = CFG.C.BG,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 10,
		Parent = MainPanel,
	})

	for _, aba in ipairs(ABAS) do
		local nome = aba[1]
		local sec = Create("ScrollingFrame", {
			Name = nome,
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundColor3 = CFG.C.BG,
			BackgroundTransparency = 0.85,
			BorderSizePixel = 0,
			ScrollBarThickness = MOBILE and 6 or 4,
			ScrollBarImageColor3 = CFG.C.RedD,
			Visible = nome == "PAINEL",
			CanvasSize = UDim2.new(0, 0, 0, 800),
			ZIndex = 2,
			Parent = ContentArea,
		})
		Sections[nome] = sec
	end

	PopularSecao("PAINEL")
end

-- ===================================================================
-- MINIMIZAR E FECHAR
-- ===================================================================
function MinimizarPainel()
	if D.Minimized then
		D.Minimized = false
		if MinimizedBar then MinimizedBar:Destroy(); MinimizedBar = nil end
		MainPanel.Size = OriginalSize
		MainPanel.Position = OriginalPosition
		Tween(MainPanel, {Size = OriginalSize, Position = OriginalPosition}, 0.3)
	else
		D.Minimized = true
		MinimizedBar = Create("CanvasGroup", {
			Name = "MinimizedBar",
			Size = UDim2.new(0, 300, 0, 36),
			Position = UDim2.new(0.5, 0, 0, -36),
			AnchorPoint = Vector2.new(0.5, 0),
			BackgroundColor3 = CFG.C.S1,
			BorderSizePixel = 0,
			ClipsDescendants = true,
			Active = true,
			Draggable = true,
			ZIndex = 998,
			Parent = MainGui,
		})
		Corner(MinimizedBar, 6)
		Stroke(MinimizedBar, CFG.C.Red, 0.3)
		Gradient(MinimizedBar, "bg")
		Create("Frame", {
			Size = UDim2.new(1, 0, 0, 2),
			Position = UDim2.new(0, 0, 1, -2),
			BackgroundColor3 = CFG.C.Red,
			BorderSizePixel = 0,
			ZIndex = 2,
			Parent = MinimizedBar,
		})
		Create("TextLabel", {
			Size = UDim2.new(1, -80, 1, 0),
			Position = UDim2.new(0, 12, 0, 0),
			Text = CFG.Name .. " (Minimizado)",
			TextColor3 = CFG.C.T1,
			Font = CFG.F.B,
			TextSize = 12,
			BackgroundTransparency = 1,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 2,
			Parent = MinimizedBar,
		})
		local expandBtn = Create("TextButton", {
			Size = UDim2.new(0, 28, 0, 28),
			Position = UDim2.new(1, -34, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			Text = "",
			BackgroundColor3 = Color3.fromRGB(30, 30, 38),
			BorderSizePixel = 0,
			AutoButtonColor = false,
			ZIndex = 2,
			Parent = MinimizedBar,
		})
		Corner(expandBtn, 4)
		Gradient(expandBtn, "btnGray")
		Create("TextLabel", {
			Size = UDim2.new(1, 0, 1, 0),
			Text = "+",
			TextColor3 = CFG.C.T1,
			Font = CFG.F.B,
			TextSize = 16,
			BackgroundTransparency = 1,
			ZIndex = 2,
			Parent = expandBtn,
		})
		expandBtn.MouseButton1Click:Connect(function()
			MinimizarPainel()
		end)
		MinimizedBar.Position = UDim2.new(0.5, 0, 0, -36)
		Tween(MinimizedBar, {Position = UDim2.new(0.5, 0, 0, 8)}, 0.3, Enum.EasingStyle.Back)
		MainPanel.Size = UDim2.new(0, 0, 0, 0)
		MainPanel.Position = UDim2.new(0.5, 0, 1.2, 0)
		Tween(MainPanel, {Size = UDim2.new(0, 0, 0, 0), Position = UDim2.new(0.5, 0, 1.2, 0)}, 0.2)
		task.delay(0.25, function() if D.Minimized then MainPanel.Visible = false end end)
	end
end

function FecharPainel()
	if D.Minimized then
		if MinimizedBar then MinimizedBar:Destroy(); MinimizedBar = nil end
		D.Minimized = false
	end
	MainPanel.Visible = false
	MainGui.Enabled = true
end

-- ===================================================================
-- INICIALIZAÇÃO
-- ===================================================================
local function Inicializar()
	if not LP.Character then
		LP.CharacterAdded:Wait()
	end
	ConstruirInterface()

	for _, jogador in pairs(Players:GetPlayers()) do
		jogador.Chatted:Connect(function(msg)
			ChatSystem:AddLog("CHAT", jogador.Name, msg)
		end)
	end
	Players.PlayerAdded:Connect(function(jogador)
		jogador.Chatted:Connect(function(msg)
			ChatSystem:AddLog("CHAT", jogador.Name, msg)
		end)
		ChatSystem:AddLog("SISTEMA", "SISTEMA", jogador.Name .. " entrou no servidor")
	end)
	Players.PlayerRemoving:Connect(function(jogador)
		ChatSystem:AddLog("SISTEMA", "SISTEMA", jogador.Name .. " saiu do servidor")
		CMD:ESP_Remover(jogador.Name)
	end)

	task.spawn(function()
		while true do
			task.wait(0.05)
			local myHRP = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
			for nome, entry in pairs(CMD.ESP) do
				local jogador = entry.Player
				if not jogador or not jogador.Parent then
					CMD:ESP_Remover(nome)
				elseif entry.BB then
					local infoLbl = entry.BB:FindFirstChild("Frame") and entry.BB.Frame:FindFirstChild("ESP_Info")
					if infoLbl then
						local txt = ""
						local char = jogador.Character
						local hrp = char and char:FindFirstChild("HumanoidRootPart")
						local hum = char and char:FindFirstChildOfClass("Humanoid")
						if D.ESP_Dist and myHRP and hrp then
							txt = txt .. math.floor((hrp.Position - myHRP.Position).Magnitude) .. "m "
						end
						if D.ESP_HP and hum then
							txt = txt .. math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth) .. " HP"
						end
						infoLbl.Text = txt
					end
				end
			end
		end
	end)

	LP.CharacterAdded:Connect(function()
		task.wait(0.3)
		if CMD.Active.NoClip then
			pcall(function()
				local char = LP.Character
				if char then
					for _, part in pairs(char:GetDescendants()) do
						if part:IsA("BasePart") then part.CanCollide = false end
					end
				end
			end)
		end
		if CMD.Active.Invisivel then
			pcall(function()
				local char = LP.Character
				if char then
					for _, part in pairs(char:GetChildren()) do
						if part:IsA("BasePart") then part.Transparency = 0.85 end
					end
				end
			end)
		end
		if CMD.Active.Velocidade then
			pcall(function()
				local char = LP.Character
				if char then
					local hum = char:FindFirstChild("Humanoid")
					if hum then hum.WalkSpeed = CMD.Active.Velocidade end
				end
			end)
		end
	end)

	UIS.InputBegan:Connect(function(input, gpe)
		if gpe then return end
		if input.KeyCode == Enum.KeyCode.F4 then
			if LoginFrame and MainPanel then
				if not LoginFrame.Visible then
					if D.Minimized then
						MinimizarPainel()
					end
					MainPanel.Visible = not MainPanel.Visible
					if not MainPanel.Visible and MinimizedBar then
						MinimizedBar.Visible = false
					elseif MainPanel.Visible and MinimizedBar then
						MinimizedBar.Visible = true
					end
				end
			end
		end
	end)

	if MOBILE then
		local toques, ultimoToque = 0, 0
		UIS.InputBegan:Connect(function(input, gpe)
			if gpe then return end
			if input.UserInputType == Enum.UserInputType.Touch then
				local agora = os.clock()
				if agora - ultimoToque < 0.4 then
					toques = toques + 1
				else
					toques = 1
				end
				ultimoToque = agora
				if toques >= 3 then
					toques = 0
					if LoginFrame and MainPanel then
						if not LoginFrame.Visible then
							if D.Minimized then MinimizarPainel() end
							MainPanel.Visible = not MainPanel.Visible
						end
					end
				end
			end
		end)
	end

	if LP.Name == CFG.Owner then
		if not table.find(D.Banned, LP.Name) then
			task.wait(0.5)
			if LoginFrame then LoginFrame.Visible = false end
			if MainPanel then MainPanel.Visible = true end
			Auth:GrantAccess()
		end
	end

	ChatSystem:AddLog("SISTEMA", "SISTEMA", "Painel v" .. CFG.Ver .. " carregado")
	print("DISTRITO ADMIN v" .. CFG.Ver .. " carregado!")

	if not SERVIDOR_OK then
		task.delay(1.5, function()
			Notify("CONFIGURAÇÃO PENDENTE",
				"Instale o DistritoAdmin_Servidor.lua em ServerScriptService para ativar o chat entre admins e a data de criação confirmada.",
				7, "w")
		end)
	end
end

local ok, erro = pcall(Inicializar)
if not ok then
	warn("DISTRITO ADMIN: Erro - " .. tostring(erro))
end
