-- ============================================
-- TOGGLE MODO RÁPIDO PC
-- ============================================
local function setupPCKeybind()
	if pcKeyConnection then
		pcKeyConnection:Disconnect()
		pcKeyConnection = nil
	end

	if not quickModePCEnabled then return end

	pcKeyConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if not quickModePCEnabled then return end

		if input.KeyCode == currentPCKey then
			sendMessage()
		end
	end)
end

local function toggleQuickModePC()
	quickModePCEnabled = not quickModePCEnabled

	if quickModePCEnabled then
		quickModePCToggle.Text = "ON"
		quickModePCToggle.BackgroundColor3 = Color3.fromRGB(0, 180, 0)
		setupPCKeybind()
	else
		quickModePCToggle.Text = "OFF"
		quickModePCToggle.BackgroundColor3 = Color3.fromRGB(255, 95, 87)
		if pcKeyConnection then
			pcKeyConnection:Disconnect()
			pcKeyConnection = nil
		end
	end
end

-- ============================================
-- SELEÇÃO DE TECLA PC
-- ============================================
local function startKeySelection()
	isWaitingForKeyInput = true
	keyInputBtn.Text = "Pressione uma tecla..."
	keyInputBtn.TextColor3 = Color3.fromRGB(255, 255, 0)
	keyInputFrame.BackgroundColor3 = Color3.fromRGB(60, 60, 0)

	local keyConnection
	keyConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if not isWaitingForKeyInput then
			keyConnection:Disconnect()
			return
		end

		if input.UserInputType == Enum.UserInputType.Keyboard then
			currentPCKey = input.KeyCode
			Config.QuickModePCKey = currentPCKey

			quickModePCLabel.Text = "⌨️ Modo Rápido PC: " .. currentPCKey.Name
			keyInputBtn.Text = "Tecla: " .. currentPCKey.Name
			keyInputBtn.TextColor3 = Color3.fromRGB(0, 255, 0)
			keyInputFrame.BackgroundColor3 = Color3.fromRGB(45, 45, 45)

			isWaitingForKeyInput = false
			keyConnection:Disconnect()

			if quickModePCEnabled then
				setupPCKeybind()
			end

			task.wait(2)
			if not isWaitingForKeyInput then
				keyInputBtn.Text = "Clique aqui e pressione uma tecla..."
				keyInputBtn.TextColor3 = Color3.fromRGB(150, 150, 150)
			end
		end
	end)
end

