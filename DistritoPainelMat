-- Reaproveita um único UIGradient por objeto (em vez de empilhar um novo a cada
-- chamada). Isso evita gradientes duplicados/"listrados" e permite trocar o
-- visual de um botão (ex: categoria ativa/inativa) só chamando Gradient() de novo.
local function Gradient(obj, tipo, cor)
	local def = GRADIENTES[tipo] or GRADIENTES.default
	local grad = obj:FindFirstChildOfClass("UIGradient")
	if not grad then
		grad = Instance.new("UIGradient")
		grad.Parent = obj
	end
	grad.Color = def.Color
	grad.Rotation = def.Rotation
	grad.Transparency = def.Transparency or NumberSequence.new(0)
	grad.Offset = def.Offset or Vector2.new(0, 0)
	return grad
end

